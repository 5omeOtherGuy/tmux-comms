#!/usr/bin/env bash
# pre-push: refuse to push when any outgoing commit introduces a credential-like
# string or a forbidden file name. Fails closed: any scanner error is a refusal.
#
# Installed into .git/hooks/pre-push by tools/install-git-hooks.sh. The scanner
# is resolved relative to the pushed repository's root, so the repo must carry
# tools/secret-scan.sh; a missing or non-executable scanner refuses the push.
#
# For every pushed ref this walks every outgoing commit (remote..local, or
# origin/main..local for a new branch) and scans each commit's own patch and
# changed file names. A secret added and later deleted is still caught because
# the commit that added it is inspected.
set -u
set -o pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "pre-push: not inside a git repository; refusing" >&2; exit 1; }
SCAN="$REPO_ROOT/tools/secret-scan.sh"
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
ZERO=0000000000000000000000000000000000000000
fail=0
local_ref=

refuse() { # ref sha why [output]
  echo "pre-push: REFUSED $1 ($2): $3" >&2
  [ -n "${4:-}" ] && printf '%s\n' "$4" >&2
  fail=1
}

# scan_commit <sha>: 0 = clean, 1 = hit, 2 = scanner error.
scan_commit() {
  local sha=$1 out rc
  # (a) the file names the commit touches, against the forbidden-name pattern.
  out=$(git show --format= --name-only "$sha" 2>&1 | "$SCAN" --names 2>&1); rc=$?
  case $rc in
    0) ;;
    1) refuse "$local_ref" "$sha" "forbidden file name in commit $sha" "$out"; return 1;;
    *) refuse "$local_ref" "$sha" "scanner error (exit $rc) scanning file names of commit $sha" "$out"; return 1;;
  esac
  # (b) the full patch of the commit, through the credential scanner.
  out=$(git show --format= "$sha" 2>&1 | "$SCAN" --stdin 2>&1); rc=$?
  case $rc in
    0) ;;
    1) refuse "$local_ref" "$sha" "credential-like content in commit $sha" "$out"; return 1;;
    *) refuse "$local_ref" "$sha" "scanner error (exit $rc) scanning commit $sha" "$out"; return 1;;
  esac
  return 0
}

while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue            # deletion: nothing outgoing
  if [ ! -x "$SCAN" ]; then
    refuse "$local_ref" "$local_sha" "scanner error: scanner missing or not executable: $SCAN"
    continue
  fi
  if [ "$remote_sha" = "$ZERO" ]; then              # new branch: diff from origin/main when it exists
    if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
      base=$(git rev-parse origin/main)
    else
      base=$EMPTY_TREE
    fi
  else
    base=$remote_sha
  fi
  if [ "$base" = "$EMPTY_TREE" ]; then
    commits=$(git rev-list "$local_sha" 2>/dev/null); rc=$?
  else
    commits=$(git rev-list "$base..$local_sha" 2>/dev/null); rc=$?
  fi
  if [ $rc -ne 0 ]; then
    refuse "$local_ref" "$local_sha" "scanner error: git rev-list failed (exit $rc)"
    continue
  fi
  while read -r sha; do
    [ -n "$sha" ] || continue
    scan_commit "$sha" || true
  done <<< "$commits"
done

[ $fail -eq 0 ] && echo "pre-push: secret scan clean"
exit $fail
