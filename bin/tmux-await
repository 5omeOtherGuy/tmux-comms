#!/usr/bin/env bash
# tmux-await — wait until a pane's composer is empty (default) or the pane is idle. Read-only.
# usage: tmux-await <pane|label> [--empty|--idle] [--timeout S] [--interval S]
# exit: 0 condition met · 1 timeout (prints pane tail) · 4 no such pane / pane dead
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$HERE/tmux-comms-lib.py"
lib() { python3 "$LIB" "$@"; }

target="" mode="empty" timeout=60 interval=1
while (($#)); do
  case "$1" in
    --empty) mode=empty; shift ;;
    --idle) mode=idle; shift ;;
    --timeout) timeout="${2:-}"; shift 2 || { echo "--timeout needs seconds" >&2; exit 1; } ;;
    --interval) interval="${2:-}"; shift 2 || { echo "--interval needs seconds" >&2; exit 1; } ;;
    -h | --help) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -?*) echo "tmux-await: unknown option $1" >&2; exit 1 ;;
    *) target="$1"; shift ;;
  esac
done
[[ -n $target && $timeout =~ ^[0-9]+$ ]] || { sed -n '3p' "$0" | sed 's/^# //' >&2; exit 1; }

pane="$(lib resolve "$target")" || exit 4
deadline=$((SECONDS + timeout))
while :; do
  IFS=$'\x1f' read -r harness state composer _marker dead _mode _cmd _text \
    < <(lib classify "$pane") || { echo "tmux-await: pane $pane vanished" >&2; exit 4; }
  if [[ $dead == 1 ]]; then echo "tmux-await: pane $pane is dead" >&2; exit 4; fi
  if [[ $mode == empty && $composer == empty ]] || [[ $mode == idle && $state == idle ]]; then
    echo "tmux-await: $pane ($harness) is $mode"
    exit 0
  fi
  if ((SECONDS >= deadline)); then
    echo "tmux-await: timeout after ${timeout}s waiting for $pane ($harness, state=$state, composer=$composer) to be $mode" >&2
    lib tail "$pane" 8 | sed 's/^/  | /' >&2
    exit 1
  fi
  sleep "$interval"
done
